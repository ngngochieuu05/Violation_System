<div data-tab-panel="employees" class="hidden space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="font-outfit text-2xl font-bold text-slate-900">Quản lý nhân viên</h2>
            <p class="mt-1 text-sm text-slate-500">Danh sách tất cả nhân viên trong hệ thống. Nghiệp vụ test model đã được tách sang trang Giám sát.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="window.openAddEmployeeModal()" class="flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-red-700">
                <i class="fa-solid fa-plus mr-2"></i>Thêm nhân viên
            </button>
        </div>
    </div>

    <div class="saas-card bg-white">
        <div class="flex items-center justify-between rounded-t-2xl border-b border-slate-100 bg-slate-50/50 p-4">
            <h3 class="font-bold text-slate-800"><i class="fa-solid fa-users mr-2 text-slate-400"></i>Danh sách nhân sự</h3>
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-sm text-slate-400"></i>
                <input type="text" id="employeeSearchInput" placeholder="Tìm kiếm nhân viên..." class="w-64 rounded-lg border border-slate-200 py-1.5 pl-9 pr-4 text-sm outline-none focus:border-red-300 focus:ring-2 focus:ring-red-100">
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="p-4 py-3 font-bold">Mã NV</th>
                        <th class="p-4 py-3 font-bold">Họ và tên</th>
                        <th class="p-4 py-3 font-bold">Phòng ban</th>
                        <th class="p-4 py-3 font-bold">Tài khoản</th>
                        <th class="p-4 py-3 text-center font-bold">Giám sát</th>
                    </tr>
                </thead>
                <tbody id="employeeListTbody">
                    <tr><td colspan="6" class="p-8 text-center text-slate-400">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="addEmployeeModal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-slate-900/50 backdrop-blur-sm transition-opacity">
    <div class="saas-card w-full max-w-md bg-white p-6 shadow-2xl scale-95 transition-transform">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-outfit text-xl font-bold text-slate-900">Thêm nhân viên mới</h3>
            <button onclick="window.closeAddEmployeeModal()" class="text-slate-400 hover:text-slate-600 transition"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Mã NV (*)</label>
                <input type="text" id="addEmpCode" class="w-full rounded-lg border border-slate-200 px-4 py-2 text-sm outline-none focus:border-red-300 focus:ring-2 focus:ring-red-100">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Họ và tên (*)</label>
                <input type="text" id="addEmpName" class="w-full rounded-lg border border-slate-200 px-4 py-2 text-sm outline-none focus:border-red-300 focus:ring-2 focus:ring-red-100">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Tài khoản (Username) (*)</label>
                <input type="text" id="addEmpUsername" class="w-full rounded-lg border border-slate-200 px-4 py-2 text-sm outline-none focus:border-red-300 focus:ring-2 focus:ring-red-100">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Mật khẩu (Mặc định: 123456)</label>
                <input type="password" id="addEmpPassword" placeholder="123456" class="w-full rounded-lg border border-slate-200 px-4 py-2 text-sm outline-none focus:border-red-300 focus:ring-2 focus:ring-red-100">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Phòng ban</label>
                <input type="text" id="addEmpDept" class="w-full rounded-lg border border-slate-200 px-4 py-2 text-sm outline-none focus:border-red-300 focus:ring-2 focus:ring-red-100">
            </div>
            <div class="pt-4 flex justify-end gap-3 border-t border-slate-100">
                <button onclick="window.closeAddEmployeeModal()" class="rounded-lg px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">Hủy</button>
                <button onclick="window.submitAddEmployee()" class="rounded-lg bg-red-600 px-5 py-2 text-sm font-medium text-white hover:bg-red-700 transition shadow-sm">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>
