@model Webapp_Quan_Li_Hanh_Vi_Vi_Pham.Areas.Admin.Models.AdminAiModelsPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Model";
    ViewData["ActivePage"] = "Models";
}

<div class="space-y-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-lg border border-emerald-100 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-lg border border-red-100 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">@TempData["ErrorMessage"]</div>
    }

    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        Runtime YOLO ưu tiên đọc model đang <strong>active</strong> từ bảng <code>AiModels</code>. Trang này đã kế thừa logic từ luồng <strong>compare/test</strong> của <code>tool_train</code> để tự đọc metadata file model và eval artifact đã lưu nếu có.
    </div>

    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="mb-2 text-3xl font-bold text-zinc-900">Quản lý Model AI</h1>
            <p class="text-sm text-zinc-500">Thêm model, kích hoạt model, và xem nhanh metadata/eval artifact trước khi đưa vào website.</p>
        </div>
        <button onclick="toggleForm('add-form-container')" class="flex items-center gap-2 rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-red-700">
            <i class="fa-solid fa-plus"></i>Thêm Model
        </button>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-zinc-500">Tổng Model</p>
            <p class="mt-1 text-3xl font-bold text-red-600">@Model.TotalModels</p>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-zinc-500">Model Active</p>
            <p class="mt-1 text-3xl font-bold text-emerald-600">@Model.ActiveModels</p>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-zinc-500">Conf trung bình</p>
            <p class="mt-1 text-3xl font-bold text-blue-600">@((Model.AverageConfThreshold * 100).ToString("0.0"))%</p>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
            <p class="text-sm text-zinc-500">Có eval artifact</p>
            <p class="mt-1 text-3xl font-bold text-purple-600">@Model.ModelsWithSavedEval</p>
        </div>
    </div>

    <div id="add-form-container" class="hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
        <div class="border-b border-zinc-100 p-6">
            <h3 class="text-lg font-bold text-zinc-900">Thêm Model AI mới</h3>
            <p class="text-sm text-zinc-500">Có thể dùng <code>.pt</code>, <code>.onnx</code> hoặc model DeepFace. Sau khi lưu, trang sẽ tự đọc metadata file và eval artifact kiểu compare/test của <code>tool_train</code>.</p>
        </div>
        <div class="p-6">
            <form id="form_add_inline" asp-action="AddAiModel" method="post" class="space-y-4">
                <input type="hidden" id="add_modelPath" name="modelPath" />
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="mb-2 block text-sm font-medium text-zinc-900">Tên Bounding Box / Tên Model</label>
                        <input type="text" name="name" required placeholder="VD: Hút thuốc" class="w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-600" />
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-zinc-900">Phân loại Model</label>
                        <select id="add_type_select" name="type" required class="w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-600">
                            <option value="YoloSmoking">Nhận diện hút thuốc (YOLO)</option>
                            <option value="YoloLeaving">Nhận diện rời vị trí (YOLO)</option>
                            <option value="Deepface">Nhận diện sinh trắc học (DeepFace)</option>
                        </select>
                    </div>
                </div>

                <div id="add_yolo_path_div">
                    <label class="mb-2 block text-sm font-medium text-zinc-900">Đường dẫn file (.pt / .onnx)</label>
                    <input type="text" id="add_yolo_input" placeholder="D:\...\best.pt hoặc D:\...\best.onnx" class="w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-600" />
                </div>
                <div id="add_df_path_div" class="hidden">
                    <label class="mb-2 block text-sm font-medium text-zinc-900">Kiến trúc DeepFace</label>
                    <select id="add_df_select" class="w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-600">
                        <option value="ArcFace">ArcFace</option>
                        <option value="VGG-Face">VGG-Face</option>
                        <option value="Facenet">Facenet</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label id="add_conf_label" class="mb-2 block text-sm font-medium text-zinc-900">Ngưỡng Conf (0.05 - 1.00)</label>
                        <input type="number" step="0.01" min="0.05" max="1" name="confThreshold" value="0.25" required class="w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-600" />
                    </div>
                    <div id="add_iou_div">
                        <label class="mb-2 block text-sm font-medium text-zinc-900">Ngưỡng IoU (0.05 - 1.00)</label>
                        <input type="number" step="0.01" min="0.05" max="1" id="add_iou_input" name="iouThreshold" value="0.45" class="w-full rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-600" />
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="toggleForm('add-form-container')" class="rounded-md border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50">Huỷ</button>
                    <input type="submit" value="Lưu Model" class="cursor-pointer rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-red-700" />
                </div>
            </form>
        </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
        <div class="border-b border-zinc-100 p-6">
            <h3 class="text-xl font-bold text-zinc-900">Danh sách Model (@Model.TotalModels)</h3>
            <p class="text-sm text-zinc-500">Metadata file và eval artifact được đọc tự động theo logic của page so sánh/kiểm thử trong <code>tool_train</code>.</p>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full whitespace-nowrap text-left text-sm">
                <thead class="border-b border-zinc-200 bg-zinc-100 text-xs uppercase text-zinc-800">
                    <tr>
                        <th class="px-6 py-4">Model</th>
                        <th class="px-6 py-4">Engine / File</th>
                        <th class="px-6 py-4">Artifact</th>
                        <th class="px-6 py-4">Class / mAP</th>
                        <th class="px-6 py-4 text-center">Trạng thái</th>
                        <th class="px-6 py-4">Cập nhật</th>
                        <th class="px-6 py-4 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Models.Any())
                    {
                        <tr><td colspan="7" class="px-6 py-8 text-center text-zinc-500">Chưa có model nào. Hãy thêm model mới.</td></tr>
                    }
                    @foreach (var item in Model.Models)
                    {
                        var classPreview = item.ClassNames.Any() ? string.Join(", ", item.ClassNames.Take(4)) : "Chưa có class name";
                        <tr class="border-b border-zinc-100 align-top transition-colors hover:bg-zinc-50/50">
                            <td class="px-6 py-4">
                                <div class="font-medium text-zinc-900">@item.Name</div>
                                <div class="mt-1 text-xs text-zinc-500">@item.Type</div>
                                <div class="mt-1 text-xs text-zinc-400">Conf @item.ConfThreshold.ToString("0.00") / IoU @item.IouThreshold.ToString("0.00")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-semibold text-zinc-800">@item.EngineLabel</div>
                                <div class="mt-1 break-all font-mono text-xs text-zinc-400">@item.ModelPath</div>
                                <div class="mt-1 text-xs text-zinc-500">@(item.FileSizeMb.HasValue ? $"{item.FileSizeMb:0.##} MB" : "Không đọc được dung lượng")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-xs text-zinc-600">Split: @(string.IsNullOrWhiteSpace(item.EvalSplit) ? "N/A" : item.EvalSplit)</div>
                                <div class="mt-1 text-xs text-zinc-600">Accuracy: @(item.Accuracy.HasValue ? $"{item.Accuracy:0.###}" : "—")</div>
                                <div class="mt-1 text-xs text-zinc-600">Macro F1: @(item.MacroF1.HasValue ? $"{item.MacroF1:0.###}" : "—")</div>
                                <div class="mt-1 text-xs text-zinc-600">Nguồn: @(string.IsNullOrWhiteSpace(item.ArtifactSource) ? "Chưa có eval artifact" : "Đã đọc từ eval*.json")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-xs text-zinc-600">mAP50: @(item.Map50.HasValue ? $"{item.Map50:0.###}" : "—")</div>
                                <div class="mt-1 text-xs text-zinc-600">mAP50-95: @(item.Map50To95.HasValue ? $"{item.Map50To95:0.###}" : "—")</div>
                                <div class="mt-2 max-w-xs whitespace-normal text-xs text-zinc-500">@classPreview</div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="rounded-full px-3 py-1 text-xs font-semibold @(item.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-zinc-100 text-zinc-600")">
                                    @(item.IsActive ? "Hoạt động" : "Vô hiệu")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-zinc-500">@item.CreatedAtUtc.ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <button type="button" onclick="navigator.clipboard.writeText('@item.ModelPath'); alert('Đã sao chép đường dẫn file.');" class="rounded-md bg-zinc-100 p-1.5 text-zinc-500 transition hover:bg-blue-100 hover:text-blue-600" title="Sao chép đường dẫn">
                                        <i class="fa-regular fa-copy"></i>
                                    </button>
                                    <button type="button" onclick="openEditModal('@item.Id', '@item.Name', '@item.Type', '@item.ModelPath', '@item.ConfThreshold.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)', '@item.IouThreshold.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)')" class="rounded-md bg-zinc-100 p-1.5 text-zinc-500 transition hover:bg-amber-100 hover:text-amber-600" title="Hiệu chỉnh">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </button>
                                    <form asp-action="ToggleAiModel" method="post" class="m-0 inline-block">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="rounded-md bg-zinc-100 p-1.5 text-zinc-500 transition hover:bg-emerald-100 hover:text-emerald-600" title="@(item.IsActive ? "Tắt model" : "Bật model")">
                                            <i class="fa-solid fa-power-off"></i>
                                        </button>
                                    </form>
                                    @if (!item.IsActive)
                                    {
                                        <form asp-action="DeleteAiModel" method="post" onsubmit="return confirm('Bạn có chắc muốn xoá model này?')" class="m-0 inline-block">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="rounded-md bg-zinc-100 p-1.5 text-zinc-500 transition hover:bg-red-100 hover:text-red-600" title="Xoá bỏ">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="unifiedEditModal" class="fixed inset-0 z-[60] hidden">
    <div class="fixed inset-0 bg-zinc-900/40 backdrop-blur-sm transition-opacity" onclick="closeModal('unifiedEditModal')"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="relative z-10 w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-xl">
            <div class="flex items-center justify-between border-b border-zinc-100 px-6 py-4">
                <h3 class="text-lg font-bold text-zinc-900">Hiệu chỉnh Model</h3>
                <button type="button" onclick="closeModal('unifiedEditModal')" class="text-zinc-400 hover:text-zinc-700">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form id="form_edit_unified" asp-action="EditAiModel" method="post">
                <input type="hidden" id="edit_id" name="id" />
                <input type="hidden" id="edit_modelPath" name="modelPath" />
                <div class="space-y-4 p-6">
                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-zinc-700">Tên Bounding Box</label>
                        <input type="text" id="edit_name" name="name" required class="w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500" />
                    </div>
                    <div id="edit_yolo_path_div">
                        <label class="mb-1.5 block text-xs font-semibold text-zinc-700">Đường dẫn file (.pt / .onnx)</label>
                        <input type="text" id="edit_yolo_input" class="w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500" />
                    </div>
                    <div id="edit_df_path_div" class="hidden">
                        <label class="mb-1.5 block text-xs font-semibold text-zinc-700">Kiến trúc DeepFace</label>
                        <select id="edit_df_select" class="w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500">
                            <option value="ArcFace">ArcFace</option>
                            <option value="VGG-Face">VGG-Face</option>
                            <option value="Facenet">Facenet</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label id="edit_conf_label" class="mb-1.5 block text-xs font-semibold text-zinc-700">Ngưỡng Conf (0.05 - 1.00)</label>
                            <input type="number" step="0.01" min="0.05" max="1" id="edit_conf" name="confThreshold" required class="w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500" />
                        </div>
                        <div id="edit_iou_div">
                            <label class="mb-1.5 block text-xs font-semibold text-zinc-700">Ngưỡng IoU (0.05 - 1.00)</label>
                            <input type="number" step="0.01" min="0.05" max="1" id="edit_iou" name="iouThreshold" required class="w-full rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-sm focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end gap-2 border-t border-zinc-100 bg-zinc-50 px-6 py-4">
                    <button type="button" onclick="closeModal('unifiedEditModal')" class="rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 hover:bg-zinc-50">Huỷ</button>
                    <input type="submit" value="Cập nhật" class="cursor-pointer rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleForm(id) {
            document.getElementById(id).classList.toggle('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        document.getElementById('add_type_select').addEventListener('change', function () {
            const isDF = this.value === 'Deepface';
            document.getElementById('add_yolo_path_div').classList.toggle('hidden', isDF);
            document.getElementById('add_df_path_div').classList.toggle('hidden', !isDF);
            document.getElementById('add_iou_div').classList.toggle('hidden', isDF);
            document.getElementById('add_conf_label').innerText = isDF ? 'Khoảng cách (Distance)' : 'Ngưỡng Conf (0.05 - 1.00)';
            document.getElementById('add_iou_input').required = !isDF;
            document.getElementById('add_iou_input').min = isDF ? '0' : '0.05';
            if (isDF) document.getElementById('add_iou_input').value = '0.00';
        });

        document.getElementById('form_add_inline').addEventListener('submit', function () {
            const isDF = document.getElementById('add_type_select').value === 'Deepface';
            document.getElementById('add_modelPath').value = isDF ? document.getElementById('add_df_select').value : document.getElementById('add_yolo_input').value;
        });

        function openEditModal(id, name, type, path, conf, iou) {
            document.getElementById('edit_id').value = id;
            document.getElementById('edit_name').value = name;
            document.getElementById('edit_conf').value = conf;
            document.getElementById('edit_iou').value = iou;

            const isDF = type === 'Deepface';
            document.getElementById('edit_yolo_path_div').classList.toggle('hidden', isDF);
            document.getElementById('edit_df_path_div').classList.toggle('hidden', !isDF);
            document.getElementById('edit_iou_div').classList.toggle('hidden', isDF);
            document.getElementById('edit_conf_label').innerText = isDF ? 'Khoảng cách (Distance)' : 'Ngưỡng Conf (0.05 - 1.00)';

            if (isDF) {
                document.getElementById('edit_df_select').value = path;
                document.getElementById('edit_iou').required = false;
                document.getElementById('edit_iou').min = '0';
            } else {
                document.getElementById('edit_yolo_input').value = path;
                document.getElementById('edit_iou').required = true;
                document.getElementById('edit_iou').min = '0.05';
            }
            document.getElementById('unifiedEditModal').classList.remove('hidden');
        }

        document.getElementById('form_edit_unified').addEventListener('submit', function () {
            const isDF = document.getElementById('edit_yolo_path_div').classList.contains('hidden');
            document.getElementById('edit_modelPath').value = isDF ? document.getElementById('edit_df_select').value : document.getElementById('edit_yolo_input').value;
        });
    </script>
}
