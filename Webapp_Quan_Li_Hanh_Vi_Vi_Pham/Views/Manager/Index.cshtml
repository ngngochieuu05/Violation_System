@{
    ViewData["Title"] = "Workspace Quản lý";
    Layout = null;
    var initialTab = (Context.Request.Query["tab"].ToString() ?? "home").ToLowerInvariant();
    if (string.IsNullOrWhiteSpace(initialTab))
    {
        initialTab = "home";
    }
}
<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ComplianceHub</title>
    <link rel="icon" type="image/png" href="/images/logo/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; margin: 0; padding: 0; }
        h1, h2, h3, h4, h5, h6, .font-outfit { font-family: 'Outfit', sans-serif; }
        .dashboard-layout { display: flex; height: 100vh; width: 100%; overflow: hidden; }
        .dashboard-sidebar { width: 260px; background-color: #ffffff; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; flex-shrink: 0; z-index: 40; }
        .dashboard-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .dashboard-header { height: 64px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; flex-shrink: 0; }
        .dashboard-content { flex: 1; overflow-y: auto; padding: 32px; background-color: #f8fafc; }
        .saas-card { background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03); transition: box-shadow 0.2s ease, transform 0.2s ease; }
        .saas-card:hover { box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06); }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">

<div class="dashboard-layout"
     data-manager-app
     data-initial-tab="@initialTab"
     data-user-id="@User.FindFirst("UserId")?.Value"
     data-username="@User.Identity?.Name"
     data-full-name="@User.FindFirst("FullName")?.Value">

    <aside class="dashboard-sidebar shadow-sm">
        <div class="flex h-16 items-center border-b border-slate-200 px-6">
            <a class="flex items-center space-x-2 text-red-600 transition hover:text-red-700" asp-area="" asp-controller="Manager" asp-action="Index">
                <img src="~/images/logo/logo.png" alt="ComplianceHub Logo" class="h-10 w-10 rounded-lg object-contain" />
                <span class="font-outfit text-xl font-extrabold tracking-tight text-slate-900">Compliance<span class="text-red-600">Hub</span></span>
            </a>
        </div>

        <div class="flex-1 space-y-1 overflow-y-auto p-4">
            <p class="mb-3 mt-2 px-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Workspace Quản lý</p>

            <button type="button" data-tab-trigger="home" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-house mr-3 w-5 text-center"></i>Trang chủ
            </button>
            <button type="button" data-tab-trigger="employees" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-users mr-3 w-5 text-center"></i>QL Nhân viên
            </button>
            <button type="button" data-tab-trigger="monitoring" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-video mr-3 w-5 text-center"></i>Giám sát
            </button>
            <button type="button" data-tab-trigger="attendance" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-fingerprint mr-3 w-5 text-center"></i>QL Chấm công
            </button>
            <button type="button" data-tab-trigger="schedule" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-calendar-check mr-3 w-5 text-center"></i>Lịch làm việc
            </button>
            <button type="button" data-tab-trigger="messages" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-comments mr-3 w-5 text-center"></i>QL Tin nhắn
            </button>
            <button type="button" data-tab-trigger="requests" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-file-signature mr-3 w-5 text-center"></i>Duyệt đơn từ
            </button>
            <button type="button" data-tab-trigger="violations" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-triangle-exclamation mr-3 w-5 text-center"></i>Lịch sử vi phạm
            </button>
            <button type="button" data-tab-trigger="payroll" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-money-check-dollar mr-3 w-5 text-center"></i>Lương thưởng
            </button>
            <button type="button" data-tab-trigger="forms" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-folder-open mr-3 w-5 text-center"></i>QL Biểu mẫu
            </button>

            <div class="my-4 border-t border-slate-200"></div>
            <p class="mb-3 px-2 text-[10px] font-bold uppercase tracking-widest text-slate-400">Hệ thống</p>

            <button type="button" data-tab-trigger="profile" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-user-gear mr-3 w-5 text-center"></i>Cài đặt hồ sơ
            </button>
            <button type="button" data-tab-trigger="settings" class="flex w-full items-center rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-600 hover:shadow-md active:scale-95">
                <i class="fa-solid fa-gear mr-3 w-5 text-center"></i>Cài đặt
            </button>
        </div>
    </aside>

    <div class="dashboard-main relative overflow-x-hidden overflow-y-visible bg-[#F5F7FA]">
        <header class="dashboard-header relative z-10 overflow-visible border-b border-slate-200 bg-white shadow-sm">
            <div>
                <h2 class="font-outfit text-xl font-bold text-slate-900">Manager Dashboard</h2>
            </div>

            <div class="flex items-center space-x-4">
                <div class="relative ml-2" id="dashboardNotificationDropdown">
                    <button type="button" class="relative text-slate-500 transition-all duration-200 hover:-translate-y-0.5 hover:text-red-600 active:scale-95 focus:outline-none" id="dashboardNotificationTrigger">
                        <i class="fa-regular fa-bell text-xl"></i>
                        <span data-notification-unread-badge class="absolute right-0 top-0 hidden h-2 w-2">
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                        </span>
                    </button>

                    <div id="dashboardNotificationMenu" class="absolute z-50 mt-2 hidden w-80 origin-top-right rounded-2xl bg-white shadow-xl ring-1 ring-slate-200" style="right: 0;">
                        <div class="flex items-center justify-between gap-2 border-b border-slate-100 px-4 py-3">
                            <p class="whitespace-nowrap text-sm font-semibold text-slate-900">Thông báo</p>
                            <span class="cursor-pointer whitespace-nowrap text-right text-xs text-red-600 hover:underline" onclick="document.querySelectorAll('[data-notification-unread-badge]').forEach(b=>b.classList.add('hidden'))">Đánh dấu đã đọc</span>
                        </div>
                        <div class="max-h-64 overflow-y-auto py-2" id="notificationListContainer">
                            <div class="px-4 py-3 text-sm text-slate-500 text-center">Đang tải...</div>
                        </div>
                    </div>
                </div>

                <div class="relative ml-4 border-l border-slate-200 pl-4" id="dashboardUserDropdown">
                    <button type="button" class="flex items-center focus:outline-none transition-all duration-200 hover:-translate-y-0.5 hover:opacity-80 hover:shadow-md active:scale-95" id="dashboardDropdownTrigger">
                        <div class="employee-avatar-placeholder relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-red-50 text-red-600 ring-2 ring-white shadow-sm">
                            <img data-avatar-image class="absolute inset-0 z-10 hidden h-full w-full object-cover" alt="Avatar" />
                            <i data-avatar-fallback class="fa-solid fa-user-tie z-0 text-xl"></i>
                        </div>
                    </button>

                    <div id="dashboardDropdownMenu" class="absolute z-50 mt-2 hidden w-48 origin-top-right rounded-2xl bg-white shadow-xl ring-1 ring-slate-200" style="right: 0;">
                        <div class="border-b border-slate-100 px-4 py-3">
                            <p class="truncate text-sm font-semibold text-slate-900" data-profile-name>@User.FindFirst("FullName")?.Value</p>
                            <p class="truncate text-xs font-bold uppercase tracking-wider text-slate-500">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
                        </div>
                        <div class="border-t border-slate-100 py-1">
                            <a href="/Account/Logout" class="flex w-full items-center px-4 py-2 text-sm font-medium text-red-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-50 hover:text-red-700 hover:shadow-md active:scale-95">
                                <i class="fa-solid fa-right-from-bracket mr-3 w-5 text-center"></i>Đăng xuất
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="dashboard-content relative" style="background: transparent;">
            <div class="mx-auto max-w-6xl space-y-8 pb-12">
                <partial name="_ManagerHomeTab" />
                <partial name="_ManageEmployeesTab" />
                <partial name="_MonitoringTab" />
                <partial name="_ManageAttendanceTab" />
                <partial name="_ManageScheduleTab" />
                <partial name="_ManageRequestsTab" />
                <partial name="_ManageMessagesTab" />
                <partial name="_ManageViolationsTab" />
                <partial name="_ManageFormsTab" />
                <partial name="_ManagePayrollTab" />
                <partial name="~/Views/Employee/_ProfileTab.cshtml" />
                <partial name="~/Views/Employee/_SettingsTab.cshtml" />
            </div>
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/notification-signalr.js" asp-append-version="true"></script>
<script src="~/js/manager.js" asp-append-version="true"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const trigger = document.getElementById('dashboardDropdownTrigger');
        const menu = document.getElementById('dashboardDropdownMenu');
        const dropdownContainer = document.getElementById('dashboardUserDropdown');

        if (trigger && menu && dropdownContainer) {
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                menu.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!dropdownContainer.contains(e.target)) {
                    menu.classList.add('hidden');
                }
            });
        }

        const notifTrigger = document.getElementById('dashboardNotificationTrigger');
        const notifMenu = document.getElementById('dashboardNotificationMenu');
        const notifContainer = document.getElementById('dashboardNotificationDropdown');

        if (notifTrigger && notifMenu && notifContainer) {
            notifTrigger.addEventListener('click', function(e) {
                e.stopPropagation();
                notifMenu.classList.toggle('hidden');
            });

            document.addEventListener('click', function(e) {
                if (!notifContainer.contains(e.target)) {
                    notifMenu.classList.add('hidden');
                }
            });
        }
    });
</script>

</body>
</html>
